# No paid service or API key is required to run locally.
PORT=3001
DATABASE_PATH=./data/opentrader.sqlite
# External data is available for a localhost personal preview only by default.
# Enabling it on a hosted deployment requires checking provider data-use rights.
# LIVE_DATA_ENABLED=true
# DATA_USE_ACKNOWLEDGED=true
# Secure cookies require an HTTPS reverse proxy in production.
# COOKIE_SECURE=true
# Registration requests require admin approval before wallets/groups are allocated.
# Provision a local admin with npm run admin:create -- --handle admin.
# REGISTRATION_OPEN=true
# Live source corrections require two separately appointed, nontrading reviewers.
# Configure existing account UUIDs; no self-service elevation is exposed.
# PLATFORM_REVIEWER_IDS=uuid-one,uuid-two
# Operator pause and periodic full reconciliation (minimum interval 60 seconds).
# TRADING_PAUSED=false
# RECONCILIATION_INTERVAL_MS=3600000
